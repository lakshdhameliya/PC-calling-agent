<Page
    x:Class="Sefirah.Views.CallAgentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <WebView2 x:Name="DashboardWebView" />
        <Border x:Name="FallbackPanel" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28" Visibility="Collapsed">
        <StackPanel Spacing="18" MaxWidth="900">
            <TextBlock Text="Call Agent" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="LakshVoiceAgent control panel" FontSize="14" Opacity="0.75" />
            <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefault}">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="StatusText" Text="Bot is stopped" FontSize="18" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="▶ Start Bot" Click="StartBot_Click" />
                        <Button Content="■ Stop Bot" Click="StopBot_Click" />
                        <Button Content="Open FAQ Dashboard" Click="OpenDashboard_Click" />
                        <Button Content="Live Chat" Click="OpenLiveChat_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Call auto-answer is handled by Frontbit Link. Start the bot here only when you want FAQ voice answers." TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        </Border>
    </Grid>
</Page>
